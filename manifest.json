{
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "description": "Create duty-leave PDFs from selected Sahrdaya Etlab absences. Profile autofill, editable details and local PDF preview.",
  "host_permissions": [
    "https://sahrdaya.etlab.in/*"
  ],
  "key": "",
  "manifest_version": 3,
  "name": "Cook my DutyLeave",
  "permissions": [
    "scripting",
    "storage",
    "downloads"
  ],
  "minimum_chrome_version": "112",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
